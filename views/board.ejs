<%- include('partials/top') %>
<%
function qs(overrides) {
  const params = Object.assign(
    { city: filters.city, state: filters.state, date: filters.date, category: filters.category, view, month: monthParam },
    overrides
  );
  return Object.entries(params)
    .filter(([k, v]) => v !== undefined && v !== null && v !== '')
    .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
    .join('&');
}
%>

<p class="eyebrow">Public &middot; free to browse</p>
<h2 class="section-title">What's happening, and where it overlaps</h2>
<p class="section-sub">Every listing is pinned by day and city. A red pin means more than one event is already booked that day in that town — a green pin means the coast is clear. Pick one city and state below to also pull in real, already-scheduled events there from Ticketmaster, tagged <strong>Public Search</strong>.</p>

<form class="filters" method="get" action="/board">
  <input type="hidden" name="view" value="<%= view %>">
  <input type="hidden" name="month" value="<%= monthParam %>">
  <input type="text" name="city" list="city-suggestions" placeholder="Any city" value="<%= filters.city === 'all' ? '' : filters.city %>">
  <datalist id="city-suggestions">
    <% cities.forEach(c => { %><option value="<%= c %>"><% }) %>
  </datalist>
  <select name="state" onchange="this.form.submit()">
    <option value="all" <%= filters.state === 'all' ? 'selected' : '' %>>All states</option>
    <% usStates.forEach(s => { %><option value="<%= s.value %>" <%= filters.state === s.value ? 'selected' : '' %>><%= s.label %> (<%= s.value %>)</option><% }) %>
  </select>
  <select name="date" onchange="this.form.submit()">
    <option value="all" <%= filters.date === 'all' ? 'selected' : '' %>>All dates</option>
    <% dates.forEach(d => { %><option value="<%= d.value %>" <%= filters.date === d.value ? 'selected' : '' %>><%= d.label %></option><% }) %>
  </select>
  <select name="category" onchange="this.form.submit()">
    <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>All categories</option>
    <% categories.forEach(c => { %><option value="<%= c.value %>" <%= filters.category === c.value ? 'selected' : '' %>><%= c.label %></option><% }) %>
  </select>
  <button class="btn-primary" type="submit">Apply filters</button>
  <span class="count"><%= count %> event<%= count === 1 ? '' : 's' %><% if (publicSearch.active && publicSearch.configured && !publicSearch.error) { %> &middot; <%= publicCount %> public search result<%= publicCount === 1 ? '' : 's' %><% } %></span>
</form>

<% if (publicSearch.active && !publicSearch.configured) { %>
  <p class="flash">Public search isn't set up on this deployment yet.</p>
<% } else if (publicSearch.active && publicSearch.error) { %>
  <p class="flash error">Public search: <%= publicSearch.error %></p>
<% } %>

<div class="view-toggle">
  <a class="view-btn <%= view === 'list' ? 'active' : '' %>" href="/board?<%= qs({ view: 'list' }) %>">List view</a>
  <a class="view-btn <%= view === 'calendar' ? 'active' : '' %>" href="/board?<%= qs({ view: 'calendar' }) %>">Full 30-day calendar</a>
</div>

<% if (view === 'list') { %>
  <div class="board-surface">
    <% if (groups.length === 0) { %>
      <p class="board-empty">No events match these filters right now.</p>
    <% } %>
    <% groups.forEach(g => { %>
      <div class="day-group">
        <p class="day-heading"><%= g.dateLabel %></p>
        <% g.cities.forEach(c => { %>
          <div class="city-cluster">
            <span class="cluster-flag <%= c.clash ? 'clash' : 'clear' %>">
              <% if (c.clash) { %>&#9888; <%= c.events.length %> events &middot; <%= c.cityKey %><% } else { %>&#9679; <%= c.cityKey %> &mdash; clear day<% } %>
            </span>
            <div class="card-row">
              <% c.events.forEach(e => { %>
                <article class="flyer">
                  <span class="pin <%= c.clash ? 'red' : 'green' %>"></span>
                  <span class="cat"><%= e.categoryLabel %></span>
                  <h3><%= e.name %></h3>
                  <div class="meta"><span><%= e.city %>, <%= e.state %></span><span><%= e.timeLabel %></span></div>
                  <% if (e.link) { %><a class="link" href="<%= e.link %>" target="_blank" rel="noopener">View event &rarr;</a><% } else { %><span class="no-link">Details coming soon</span><% } %>
                </article>
              <% }) %>
            </div>
          </div>
        <% }) %>
        <% if (g.publicEvents && g.publicEvents.length) { %>
          <div class="city-cluster">
            <span class="cluster-flag public">&#128269; Public Search &middot; <%= publicSearch.city %>, <%= publicSearch.state %></span>
            <div class="card-row">
              <% g.publicEvents.forEach(e => { %>
                <article class="flyer public-flyer">
                  <span class="pin gold"></span>
                  <span class="cat">Public Search &middot; Ticketmaster</span>
                  <h3><%= e.name %></h3>
                  <div class="meta"><% if (e.venue) { %><span><%= e.venue %></span><% } %><span><%= e.timeLabel %></span></div>
                  <% if (e.url) { %><a class="link" href="<%= e.url %>" target="_blank" rel="noopener">View event &rarr;</a><% } else { %><span class="no-link">Details coming soon</span><% } %>
                </article>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="board-surface">
    <p class="cal-month">
      <a href="/board?<%= qs({ month: prevMonthParam }) %>">&larr; prev</a>
      <span><%= monthLabel %> &middot; full month</span>
      <a href="/board?<%= qs({ month: nextMonthParam }) %>">next &rarr;</a>
    </p>
    <div class="cal-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
    <div class="cal-grid">
      <% calDays.forEach(d => { %>
        <% if (!d) { %><span class="cal-day cal-blank"></span>
        <% } else { %>
          <a class="cal-day <%= d.count >= 2 ? 'busy' : d.count === 1 ? 'one' : '' %> <%= d.date === selectedDate ? 'selected' : '' %>"
             href="/board?<%= qs({ date: d.date }) %>"><%= d.day %><% if (d.count >= 2) { %><b><%= d.count %></b><% } %></a>
        <% } %>
      <% }) %>
    </div>
    <div class="cal-legend">
      <span><span class="sw open"></span>Nothing booked</span>
      <span><span class="sw one"></span>1 event</span>
      <span><span class="sw busy"></span>2+ events</span>
    </div>
    <% if (selectedDate) { %>
      <div class="conflict-box <%= (detail.length === 0 && detailPublic.length === 0) ? 'clear' : '' %>">
        <% if (detail.length === 0 && detailPublic.length === 0) { %>
          <p class="lead clear">Nothing booked on <%= selectedDateLabel %></p>
          <p class="conflict-note">Clear day, given the filters above.</p>
        <% } else { %>
          <% if (detail.length) { %>
            <p class="lead"><%= detail.length %> event<%= detail.length > 1 ? 's' : '' %> on <%= selectedDateLabel %></p>
            <% detail.forEach(e => { %>
              <div class="conflict-item"><span><%= e.name %> &middot; <%= e.city %>, <%= e.state %></span><span class="time"><%= e.timeLabel %></span></div>
            <% }) %>
          <% } %>
          <% if (detailPublic.length) { %>
            <p class="lead" <% if (detail.length) { %>style="margin-top: 14px;"<% } %>>&#128269; <%= detailPublic.length %> public search result<%= detailPublic.length > 1 ? 's' : '' %></p>
            <% detailPublic.forEach(e => { %>
              <div class="conflict-item"><span><%= e.name %><% if (e.venue) { %> &middot; <%= e.venue %><% } %></span><span class="time"><%= e.timeLabel %></span></div>
            <% }) %>
          <% } %>
        <% } %>
      </div>
    <% } else { %>
      <div class="conflict-box clear">
        <p class="lead clear">Click a day to see what's booked</p>
        <p class="conflict-note">Counts respect the filters above.</p>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('partials/bottom') %>
