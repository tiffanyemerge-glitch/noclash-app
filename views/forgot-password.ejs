<%- include('partials/top') %>

<p class="eyebrow">Trouble logging in?</p>
<h2 class="section-title">Reset your password</h2>

<% if (sent) { %>
  <div class="form-card" style="max-width:420px;">
    <p>If an account exists for that email, we've sent a link to reset the password. Check your inbox (and spam folder) — the link expires in an hour.</p>
    <p class="hint"><a href="/login">Back to log in</a></p>
  </div>
<% } else { %>
  <% if (errors && errors.length) { %>
    <p class="flash error"><%= errors.join(' ') %></p>
  <% } %>
  <form method="post" action="/forgot-password">
    <div class="form-card" style="max-width:420px;">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <button class="btn-primary block" type="submit">Send reset link</button>
      <p class="hint"><a href="/login">Back to log in</a></p>
    </div>
  </form>
<% } %>

<%- include('partials/bottom') %>
