<%- include('partials/top') %>
<%
function qs(overrides) {
  const params = Object.assign({ city, state, month: monthParam, date: selectedDate }, overrides);
  return Object.entries(params)
    .filter(([k, v]) => v !== undefined && v !== null && v !== '')
    .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
    .join('&');
}
%>

<p class="eyebrow">Organizer &middot; $1&ndash;$5 per listing</p>
<h2 class="section-title">Post your event</h2>
<p class="section-sub">Enter your city and the calendar shows which days already have something booked. Choose a clear day, or go in with eyes open — either way, it's your call.</p>

<% if (errors && errors.length) { %><p class="flash error"><%= errors.join(' ') %></p><% } %>

<div class="post-grid">
  <div class="side-card">
    <h3>Check availability</h3>
    <p class="card-sub">Enter a city to see its month at a glance.</p>
    <form method="get" action="/post" style="display:flex; gap:8px; margin-bottom:16px;">
      <input type="hidden" name="month" value="<%= monthParam %>">
      <input type="text" name="city" value="<%= city %>" placeholder="City" required style="flex:1; padding:10px 11px; border-radius:8px; border:1px solid var(--line); background:var(--surface); font-family:'IBM Plex Mono',monospace;">
      <select name="state" required style="width:96px; padding:10px 11px; border-radius:8px; border:1px solid var(--line); background:var(--surface); font-family:'IBM Plex Mono',monospace;">
        <option value="" disabled <%= state ? '' : 'selected' %>>State</option>
        <% usStates.forEach(s => { %><option value="<%= s.value %>" <%= state === s.value ? 'selected' : '' %>><%= s.value %></option><% }) %>
      </select>
      <button class="btn-primary" type="submit">Check</button>
    </form>

    <% if (calDays) { %>
      <p class="cal-month">
        <a href="/post?<%= qs({ month: prevMonthParam, date: '' }) %>">&larr; prev</a>
        <span><%= monthLabel %></span>
        <a href="/post?<%= qs({ month: nextMonthParam, date: '' }) %>">next &rarr;</a>
      </p>
      <div class="cal-weekdays"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
      <div class="cal-grid">
        <% calDays.forEach(d => { %>
          <% if (!d) { %><span class="cal-day cal-blank"></span>
          <% } else { %>
            <a class="cal-day <%= d.count >= 2 ? 'busy' : d.count === 1 ? 'one' : '' %> <%= d.date === selectedDate ? 'selected' : '' %>"
               data-date="<%= d.date %>"
               href="/post?<%= qs({ date: d.date }) %>"><%= d.day %><% if (d.count >= 2) { %><b><%= d.count %></b><% } %></a>
          <% } %>
        <% }) %>
      </div>
      <div class="cal-legend">
        <span><span class="sw open"></span>Nothing booked</span>
        <span><span class="sw one"></span>1 event</span>
        <span><span class="sw busy"></span>2+ events</span>
      </div>
      <% if (selectedDate) { %>
        <div class="conflict-box <%= conflicts.length === 0 ? 'clear' : '' %>">
          <% if (conflicts.length === 0) { %>
            <p class="lead clear">Nothing booked yet in <%= city %>, <%= state %> on <%= selectedDateLabel %></p>
            <p class="conflict-note">Looks like a clear day.</p>
          <% } else { %>
            <p class="lead"><%= conflicts.length %> event<%= conflicts.length > 1 ? 's' : '' %> already booked in <%= city %>, <%= state %> on <%= selectedDateLabel %></p>
            <% conflicts.forEach(e => { %>
              <div class="conflict-item"><span><%= e.name %></span><span class="time"><%= e.timeLabel %></span></div>
            <% }) %>
            <p class="conflict-note">This won't stop your listing &mdash; it's here so you can spread events out if you'd rather not compete for the same crowd.</p>
          <% } %>
        </div>

        <div class="side-card" style="margin-top:12px;">
          <h3 style="font-size:0.95rem;">Also happening outside NoClash</h3>
          <% if (!ticketmasterConfigured) { %>
            <p class="hint">Not set up yet. Add a free <code>TICKETMASTER_API_KEY</code> in <code>.env</code> to check Ticketmaster for other ticketed events that day &mdash; see README.md. (Eventbrite can't be checked this way: they shut off public search access to third-party apps in 2020.)</p>
          <% } else { %>
            <% externalResults.forEach(result => { %>
              <% if (result.error) { %>
                <p class="hint"><%= result.provider %>: <%= result.error %></p>
              <% } else if (result.events.length === 0) { %>
                <p class="hint">Nothing found on <%= result.provider %> for <%= city %>, <%= state %> that day.</p>
              <% } else { %>
                <p class="card-sub"><%= result.events.length %> ticketed event<%= result.events.length > 1 ? 's' : '' %> on <%= result.provider %> that day (not a NoClash listing, so it won't stop you from posting):</p>
                <% result.events.forEach(e => { %>
                  <div class="conflict-item">
                    <span><a class="link" href="<%= e.url %>" target="_blank" rel="noopener"><%= e.name %></a><% if (e.venue) { %> &middot; <%= e.venue %><% } %></span>
                    <span class="time"><%= e.timeLabel || '' %></span>
                  </div>
                <% }) %>
              <% } %>
            <% }) %>
          <% } %>
        </div>
      <% } else { %>
        <div class="conflict-box clear">
          <p class="lead clear">Pick a day above</p>
          <p class="conflict-note">We'll show you what's already booked that day in <%= city %>, <%= state %>.</p>
        </div>
      <% } %>
    <% } else { %>
      <p class="hint">Enter a city and state above to see the availability calendar.</p>
    <% } %>
  </div>

  <div>
    <div class="form-card">
      <h3>Event details</h3>
      <% if (selectedDate) { %>
        <p class="posting-for">Posting for <strong><%= selectedDateLabel %></strong> in <strong><%= city %>, <%= state %></strong></p>
      <% } else { %>
        <p class="card-sub">Pick a date from the calendar to continue.</p>
      <% } %>

      <form method="post" action="/post">
        <input type="hidden" name="city" value="<%= city %>">
        <input type="hidden" name="state" value="<%= state %>">
        <input type="hidden" name="date" value="<%= selectedDate || '' %>">

        <div class="field">
          <label for="name">Event name</label>
          <input type="text" id="name" name="name" value="<%= values.name || '' %>" required>
        </div>
        <div class="field-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="field">
            <label for="startTime">Start time</label>
            <input type="time" id="startTime" name="startTime" value="<%= values.startTime || '10:00' %>" required>
          </div>
          <div class="field">
            <label for="endTime">End time <span style="text-transform:none; font-weight:400;">(optional)</span></label>
            <input type="time" id="endTime" name="endTime" value="<%= values.endTime || '' %>">
          </div>
        </div>
        <div class="field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <% categories.forEach(c => { %><option value="<%= c.value %>"><%= c.label %></option><% }) %>
          </select>
        </div>
        <label class="checkline">
          <input type="checkbox" name="isVirtual" id="isVirtual"> This is a virtual / online event
        </label>
        <div class="field" id="venue-field">
          <label for="venue">Venue name or address <span style="text-transform:none; font-weight:400;">(optional, but helps us catch nearby clashes)</span></label>
          <input type="text" id="venue" name="venue" value="<%= values.venue || '' %>" placeholder="e.g. 123 Main St or The Norva">
          <p class="hint">Used to check for events nearby on the same day. Without it, we can only compare by city.</p>
        </div>
        <div class="field">
          <label for="tags">Tags <span style="text-transform:none; font-weight:400;">(optional, comma-separated, up to 5)</span></label>
          <input type="text" id="tags" name="tags" value="<%= values.tags || '' %>" placeholder="e.g. live music, local makers">
        </div>
        <div class="field-row" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="field">
            <label for="audienceType">Who's this for</label>
            <select id="audienceType" name="audienceType">
              <% audienceTypes.forEach(a => { %><option value="<%= a.value %>"><%= a.label %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="expectedAttendance">Expected attendance <span style="text-transform:none; font-weight:400;">(optional)</span></label>
            <input type="number" id="expectedAttendance" name="expectedAttendance" min="0" value="<%= values.expectedAttendance || '' %>">
          </div>
        </div>

        <div id="conflict-panel"></div>
        <input type="hidden" id="seenFlagEventIds" name="seenFlagEventIds" value="">

        <div class="field">
          <label for="description">Description <span style="text-transform:none; font-weight:400;">(optional)</span></label>
          <textarea id="description" name="description" rows="3" maxlength="600" placeholder="A couple sentences about the event — what it is, who it's for. Shows on your event's page and helps it turn up in search."><%= values.description || '' %></textarea>
        </div>
        <div class="field">
          <label for="link">Event link</label>
          <input type="text" id="link" name="link" placeholder="https://" disabled>
        </div>
        <label class="checkline">
          <input type="checkbox" name="noLink" id="noLink" checked onchange="document.getElementById('link').disabled = this.checked;"> I don't have a link yet
        </label>
        <p class="hint">No problem &mdash; edit your listing anytime from your dashboard to add it later.</p>

        <div class="side-card" style="margin-top:18px; padding:18px;">
          <h3>Pay &amp; post</h3>
          <div class="plan-options" id="plan-options">
            <label class="plan-opt" data-price="<%= PLANS.standard.price %>" data-duration="Live until the day of your event.">
              <span class="label"><span class="label-row"><input type="radio" name="plan" value="standard" checked> Standard listing</span><span class="sub">Live until the day of your event</span></span>
              <span class="price">$<%= PLANS.standard.price %></span>
            </label>
            <label class="plan-opt" data-price="<%= PLANS.basic.price %>" data-duration="Live for 60 days.">
              <span class="label"><span class="label-row"><input type="radio" name="plan" value="basic"> Basic listing</span><span class="sub">Live for 60 days</span></span>
              <span class="price">$<%= PLANS.basic.price %></span>
            </label>
            <label class="plan-opt" data-price="<%= PLANS.featured.price %>" data-duration="Live until the day of your event.">
              <span class="label"><span class="label-row"><input type="radio" name="plan" value="featured"> Featured &middot; pinned 7 days</span><span class="sub">Live until the day of your event</span></span>
              <span class="price">$<%= PLANS.featured.price %></span>
            </label>
            <label class="plan-opt" data-price="0" data-duration="Included in your Organizer Pass.">
              <span class="label"><span class="label-row"><input type="radio" name="plan" value="pass" <%= hasPass ? '' : 'disabled' %>> Use my Organizer Pass</span><span class="sub"><%= hasPass ? 'Unlimited listings, already active' : 'Requires an active pass' %></span></span>
              <span class="price">included</span>
            </label>
          </div>
          <% if (!hasPass) { %><p class="hint">Don't have a pass yet? <a href="/dashboard"><%= stripeConfigured ? 'Buy one' : 'Activate the demo pass' %></a> from your dashboard.</p><% } %>
          <div class="total-row">
            <span>Total due today</span>
            <span class="amount" id="post-total">$<%= PLANS.standard.price %>.00</span>
          </div>
          <p class="total-hint" id="post-duration-note">Live until the day of your event.</p>
          <% if (stripeConfigured) { %>
            <p class="hint">You'll be taken to Stripe to pay securely — your listing goes live once the payment clears.</p>
          <% } else { %>
            <p class="hint">Demo mode &mdash; payments aren't set up, so nothing will actually be charged. See README.md to turn on real checkout.</p>
          <% } %>
          <button class="btn-primary block" type="submit" <%= selectedDate ? '' : 'disabled' %>><%= stripeConfigured ? 'Continue to payment' : 'Reserve this listing' %></button>
          <p class="hint" id="submit-anyway-hint" style="display:none;">You can still submit. Clashes are just a heads-up.</p>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('#plan-options .plan-opt').forEach(function (opt) {
    opt.addEventListener('click', function () {
      var radio = opt.querySelector('input[type="radio"]');
      if (radio.disabled) return;
      radio.checked = true;
      document.getElementById('post-total').textContent = '$' + parseFloat(opt.dataset.price).toFixed(2);
      document.getElementById('post-duration-note').textContent = opt.dataset.duration;
    });
  });

  // ---------- Near-Conflict Auto-Flag: live check, panel, date-picker dots ----------
  // See the "NoClash — Near-Conflict Auto-Flag Spec" project doc. Date/city/state are fixed for
  // this page load (picking a different one reloads the page via the calendar above), so the only
  // things that trigger a live check are the fields inside the form itself.
  (function () {
    var ctx = { date: <%- JSON.stringify(selectedDate) %>, city: <%- JSON.stringify(city) %>, state: <%- JSON.stringify(state) %> };
    var panel = document.getElementById('conflict-panel');
    var seenInput = document.getElementById('seenFlagEventIds');
    var submitHint = document.getElementById('submit-anyway-hint');
    var venueField = document.getElementById('venue-field');
    var isVirtualBox = document.getElementById('isVirtual');
    var checkTimer = null;
    var dotsTimer = null;

    function toggleVirtual() {
      venueField.style.display = isVirtualBox.checked ? 'none' : '';
    }
    isVirtualBox.addEventListener('change', toggleVirtual);
    toggleVirtual();

    function fieldValues() {
      return {
        date: ctx.date,
        startTime: document.getElementById('startTime').value,
        endTime: document.getElementById('endTime').value,
        city: ctx.city,
        state: ctx.state,
        venue: document.getElementById('venue').value,
        category: document.getElementById('category').value,
        tags: document.getElementById('tags').value,
        audienceType: document.getElementById('audienceType').value,
        expectedAttendance: document.getElementById('expectedAttendance').value,
        isVirtual: isVirtualBox.checked
      };
    }

    function tierLabel(tier) { return tier === 'direct' ? 'Direct clash' : 'Near conflict'; }

    function renderPanel(data) {
      if (!data || !data.ready) { panel.innerHTML = ''; submitHint.style.display = 'none'; seenInput.value = ''; return; }

      seenInput.value = data.flags.map(function (f) { return f.eventId; }).join(',');

      if (!data.flags.length) {
        panel.innerHTML = '<div class="conflict-box clear"><p class="lead clear">No clashes found nearby. Nice pick.</p></div>';
        submitHint.style.display = 'none';
        return;
      }

      submitHint.style.display = 'block';
      var hasDirect = data.flags.some(function (f) { return f.tier === 'direct'; });
      var header = hasDirect
        ? 'Heads up: ' + data.flags.length + (data.flags.length === 1 ? ' event may' : ' events may') + ' compete for your audience'
        : (data.flags.length === 1 ? '1 nearby event on this date' : data.flags.length + ' nearby events on this date');

      var itemsHtml = data.flags.map(function (f) {
        var venueBit = f.venue ? f.venue : (f.distanceMi != null ? f.distanceMi.toFixed(1) + ' mi away' : (f.city + ', ' + f.state));
        var distBit = f.distanceMi != null ? f.distanceMi.toFixed(1) + ' mi away' : '';
        return '' +
          '<div class="conflict-item flag-item">' +
            '<span>' +
              '<span class="tier-badge ' + f.tier + '">' + tierLabel(f.tier) + '</span> ' +
              '<a class="link" href="/events/' + f.slug + '" target="_blank" rel="noopener">' + f.title + '</a>' +
              '<br><span class="hint" style="margin-top:2px;">' + f.date + ' &middot; ' + venueBit + (distBit && f.venue ? ' &middot; ' + distBit : '') + '<br>' + f.reason + '</span>' +
            '</span>' +
          '</div>';
      }).join('');

      var moreHtml = data.moreCount > 0
        ? '<p class="conflict-note"><a class="link" href="/board?city=' + encodeURIComponent(ctx.city) + '&state=' + encodeURIComponent(ctx.state) + '&date=' + encodeURIComponent(ctx.date) + '">+' + data.moreCount + ' more event' + (data.moreCount > 1 ? 's' : '') + ' that day &rarr;</a></p>'
        : '';

      var clearHtml = data.clearDates && data.clearDates.length
        ? '<div class="clear-dates"><span class="hint">Pick another date:</span> ' +
          data.clearDates.map(function (d) {
            var url = '/post?city=' + encodeURIComponent(ctx.city) + '&state=' + encodeURIComponent(ctx.state) + '&month=<%= monthParam %>&date=' + encodeURIComponent(d);
            return '<a class="btn-outline-ink" style="padding:5px 10px;font-size:0.76rem;margin:4px 6px 0 0;display:inline-block;" href="' + url + '">' + d + '</a>';
          }).join('') +
          '</div>'
        : '';

      var ungeocodableHtml = data.ungeocodable
        ? '<p class="conflict-note">Couldn\'t check nearby events by distance &mdash; add a fuller address above for a more precise check. Showing same-city results instead.</p>'
        : '';

      panel.innerHTML = '<div class="conflict-box"><p class="lead">' + header + '</p>' + itemsHtml + ungeocodableHtml + moreHtml + clearHtml + '</div>';
    }

    function runCheck() {
      var v = fieldValues();
      if (!ctx.date || !v.startTime || !v.category || (!v.isVirtual && !ctx.city)) { panel.innerHTML = ''; submitHint.style.display = 'none'; return; }
      var params = new URLSearchParams(v);
      fetch('/api/conflicts/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(renderPanel)
        .catch(function () { /* live check is a nice-to-have — fail quietly, submission still works */ });
    }

    function scheduleCheck() {
      clearTimeout(checkTimer);
      checkTimer = setTimeout(runCheck, 500);
    }

    ['startTime', 'endTime', 'category', 'venue', 'tags', 'audienceType', 'expectedAttendance'].forEach(function (id) {
      document.getElementById(id).addEventListener('input', scheduleCheck);
      document.getElementById(id).addEventListener('change', scheduleCheck);
    });
    isVirtualBox.addEventListener('change', scheduleCheck);
    if (ctx.date) runCheck();

    // Date-picker dots: shade the calendar above once venue/category give the scorer something to
    // work with. Re-runs (debounced) whenever venue/category/audience/tags/virtual change.
    function applyDots(tiers) {
      document.querySelectorAll('.cal-day[data-date]').forEach(function (el) {
        el.querySelectorAll('.flag-dot').forEach(function (dot) { dot.remove(); });
        var tier = tiers[el.dataset.date];
        if (!tier) return;
        var dot = document.createElement('i');
        dot.className = 'flag-dot ' + tier;
        el.appendChild(dot);
      });
    }

    function runDots() {
      if (!ctx.city && !isVirtualBox.checked) return;
      var v = fieldValues();
      if (!v.category) return;
      var params = new URLSearchParams({
        year: '<%= monthParam.slice(0,4) %>',
        month: String(Number('<%= monthParam.slice(5,7) %>') - 1),
        city: ctx.city, state: ctx.state, venue: v.venue, category: v.category,
        audienceType: v.audienceType, tags: v.tags, isVirtual: String(v.isVirtual)
      });
      fetch('/api/conflicts/calendar?' + params.toString())
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) { if (data) applyDots(data.tiers || {}); })
        .catch(function () {});
    }

    function scheduleDots() {
      clearTimeout(dotsTimer);
      dotsTimer = setTimeout(runDots, 500);
    }

    ['category', 'venue', 'tags', 'audienceType'].forEach(function (id) {
      document.getElementById(id).addEventListener('input', scheduleDots);
      document.getElementById(id).addEventListener('change', scheduleDots);
    });
    isVirtualBox.addEventListener('change', scheduleDots);
    if (document.getElementById('category').value) runDots();
  })();
</script>

<%- include('partials/bottom') %>
