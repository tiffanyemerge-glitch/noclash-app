<%- include('partials/top') %>

<p class="eyebrow">Hampton Roads &middot; free to browse</p>
<h1 class="section-title">Hampton Roads events, by city</h1>
<p class="section-sub">NoClash tracks events across the region so organizers can see what's already on the books before they pick a date.<% if (totalTracked > 0) { %> Right now we're tracking <strong><%= totalTracked %></strong> public event<%= totalTracked === 1 ? '' : 's' %> from city calendars across Hampton Roads.<% } %> Pick a city below to browse its calendar and post your own &mdash; or <a href="/board">search the whole board</a> across every city and state at once.</p>

<div class="city-grid">
  <% cities.forEach(c => { %>
    <a class="city-card" href="/cities/<%= c.slug %>">
      <h3><%= c.name %>, VA</h3>
      <p><%= c.blurb %></p>
      <span class="count">
        <% if (c.eventCount > 0) { %>
          <%= c.eventCount %> upcoming event<%= c.eventCount === 1 ? '' : 's' %> on NoClash
        <% } else if (c.trackedCount > 0) { %>
          0 posted on NoClash yet &middot; <%= c.trackedCount %> public event<%= c.trackedCount === 1 ? '' : 's' %> tracked nearby
        <% } else { %>
          0 posted yet &mdash; be the first
        <% } %>
      </span>
    </a>
  <% }) %>
</div>

<%- include('partials/bottom') %>
